+    public static int pluto$canSpawn(ServerLevel level, LevelChunk chunk, NaturalSpawner.SpawnState spawnState, MobCategory mobCategory) {
+        int maxSpawns;
+        if (level.paperConfig().entities.spawning.perPlayerMobSpawns) {
+            // Copied from getFilteredSpawningCategories
+            int limit = mobCategory.getMaxInstancesPerChunk();
+            org.bukkit.entity.SpawnCategory spawnCategory = org.bukkit.craftbukkit.util.CraftSpawnCategory.toBukkit(mobCategory);
+            if (org.bukkit.craftbukkit.util.CraftSpawnCategory.isValidForLimits(spawnCategory)) {
+                limit = level.getWorld().getSpawnLimit(spawnCategory);
+            }
+
+            // Apply per-player limit
+            int minDiff = Integer.MAX_VALUE;
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<net.minecraft.server.level.ServerPlayer> inRange =
+                level.moonrise$getNearbyPlayers().getPlayers(chunk.getPos(), ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.TICK_VIEW_DISTANCE);
+            if (inRange != null) {
+                final net.minecraft.server.level.ServerPlayer[] backingSet = inRange.getRawDataUnchecked();
+                for (int k = 0, len = inRange.size(); k < len; k++) {
+                    minDiff = Math.min(limit - level.getChunkSource().chunkMap.getMobCountNear(backingSet[k], mobCategory), minDiff);
+                }
+            }
+
+            maxSpawns = (minDiff == Integer.MAX_VALUE) ? 0 : minDiff;
+        } else {
+            maxSpawns = spawnState.canSpawnForCategoryLocal(mobCategory, chunk.getPos()) ? Integer.MAX_VALUE : Integer.MIN_VALUE;
+        }
+        return maxSpawns;
+    }
+    public static void pluto$spawnForChunk(ServerLevel level, LevelChunk chunk, NaturalSpawner.SpawnState spawnState, List<MobCategory> categories) {
+        List<Runnable> tasks = new ArrayList<>();
+        for (MobCategory mobCategory : categories) {
+            // Paper start - Optional per player mob spawns
+            if (pluto$canSpawn(level, chunk, spawnState, mobCategory) > 0) {
+                final Runnable runnable = pluto$spawnCategoryForChunk(mobCategory, level, chunk, spawnState);
+                // Paper end - Optional per player mob spawns
+                if (runnable == null) continue;
+                tasks.add(runnable);
+            }
+        }
+
+        if (tasks.isEmpty()) return;
+
+        // Send the actual entity spawns to the main thread
+        java.util.List<java.util.concurrent.CompletableFuture<Void>> list = new java.util.ArrayList<>();
+        for (Runnable runnable : tasks) {
+            list.add(java.util.concurrent.CompletableFuture.runAsync(runnable, level.getChunkSource().mainThreadProcessor));
+        }
+        // We have to wait for the main thread else the mob caps get ignored.
+        java.util.concurrent.CompletableFuture.allOf(list.toArray(new java.util.concurrent.CompletableFuture[0])).join();
+    }
+
+    @Nullable
+    public static Runnable pluto$spawnCategoryForChunk(MobCategory category, ServerLevel level, LevelChunk chunk, NaturalSpawner.SpawnState spawnState) {
+        BlockPos randomPosWithin = getRandomPosWithin(level, chunk);
+        return randomPosWithin.getY() >= level.getMinY() + 1 ? () -> {
+            final int maxSpawns = pluto$canSpawn(level, chunk, spawnState, category);
+            if (maxSpawns <= 0) return;
+            spawnCategoryForPosition(category, level, chunk, randomPosWithin, spawnState::canSpawn, spawnState::afterSpawn, maxSpawns, level.paperConfig().entities.spawning.perPlayerMobSpawns ? level.getChunkSource().chunkMap::updatePlayerMobTypeMap : null);
+        } : null;
+    }
+    // Pluto end - Async spawning chunks
